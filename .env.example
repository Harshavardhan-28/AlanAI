# Dev environment template. Copy to .env and fill real values locally.
# NEVER commit a real .env.

# Core
DATABASE_URL=postgresql+asyncpg://mcpaudit:mcpaudit@localhost:5432/mcpaudit
REDIS_URL=redis://localhost:6379/0

# S3-compatible object store (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mcpaudit
S3_SECRET_KEY=mcpaudit-dev-only
S3_BUCKET_SNAPSHOTS=mcpaudit-snapshots
S3_BUCKET_EVIDENCE=mcpaudit-evidence
S3_BUCKET_DOCS=mcpaudit-docs

# Auth
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=mcpaudit

# LLM provider for judge/injection agents. Leave empty for deterministic offline mock mode.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Scoring config version
SCORING_CONFIG_PATH=packages/shared/scoring/scoring.v1.yaml

# Sandbox
SANDBOX_RUNTIME=docker
SANDBOX_EGRESS_PROXY_PORT=18080
